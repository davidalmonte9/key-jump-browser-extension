{
  "name": "key-jump-plus",
  "version": "5.4.0",
  "description": "Key Jump Plus: keyboard navigation with hints. No mouse needed.",
  "author": "David Almonte",
  "license": "MIT",
  "private": true,
  "scripts": {
    "lint": "prettier --check \"**/*.{md,json,js,css,html}\" && eslint . && web-ext lint",
    "lint:fix": "prettier --write \"**/*.{md,json,js,css,html}\" && eslint --fix . && web-ext lint",
    "test": "npm run lint",
    "build": "web-ext build",
    "start": "web-ext run",
    "serve-tests": "node npm-scripts/start.js"
  },
  "devDependencies": {
    "babel-eslint": "10.1.0",
    "eslint": "7.26.0",
    "eslint-config-prettier": "8.3.0",
    "prettier": "2.3.0",
    "web-ext": "10.6.0"
  },
  "contributors": [
    "Kenneth Sundqvist <kenneth@kesu.se> (kesu.se)"
  ]
}
